{
  "openapi": "3.1.0",
  "info": {
    "title": "Joy Web Manager Developer Actions",
    "version": "1.0.0",
    "description": "Focused Actions for Joy Web Manager to inspect the Joy repository, create protected work branches, apply safe source changes, run verification, and open draft pull requests. It cannot write main, merge, deploy, modify secrets, migrations, workflows, dependencies, Wrangler configuration, or Joy Dev Bridge security files."
  },
  "servers": [
    {
      "url": "https://app.hey-joy.workers.dev"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
