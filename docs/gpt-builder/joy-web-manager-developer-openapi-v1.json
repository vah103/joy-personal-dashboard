      "get": {
        "operationId": "getJoyOverview",
        "summary": "Get the current Joy overview",
        "description": "Read current projects, open tasks, inbox tasks, and recent logs.",
        "responses": {
          "200": {
            "description": "Current Joy overview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error response",
