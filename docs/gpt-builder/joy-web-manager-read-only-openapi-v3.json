{
  "openapi": "3.0.3",
  "info": {
    "title": "Joy Web Manager Read-Only Actions",
    "version": "1.0.3",
    "description": "Read-only actions for inspecting current Joy project and repository state. No write, branch, commit, pull-request, migration, or deployment operations are exposed."
  },
  "servers": [
    {
      "url": "https://app.hey-joy.workers.dev"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/joy/v1/overview": {
      "get": {
        "operationId": "getJoyOverview",
        "summary": "Get the current Joy overview",
        "responses": {
          "200": {
            "description": "Current Joy overview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/joy/v1/projects": {
      "get": {
        "operationId": "listJoyProjects",
        "summary": "List Joy projects",
        "responses": {
          "200": {
            "description": "Joy projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/joy/v1/projects/{projectId}": {
      "get": {
        "operationId": "getJoyProject",
        "summary": "Get one Joy project",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/joy/v1/workspaces/{projectId}": {
      "get": {
        "operationId": "bootstrapJoyWorkspace",
        "summary": "Load one Joy project workspace",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/joy/v1/dev/repository": {
      "get": {
        "operationId": "getJoyRepositoryContext",
        "summary": "Read current repository context",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryContextResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/joy/v1/dev/search": {
      "get": {
        "operationId": "searchJoyRepository",
        "summary": "Search the Joy repository",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositorySearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/joy/v1/dev/files": {
      "get": {
        "operationId": "readJoyRepositoryFile",
        "summary": "Read one current repository file",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryFileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "ProjectSummary": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "progress": {"type": "integer"}
        },
        "additionalProperties": true
      },
      "TaskSummary": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "projectId": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      },
      "LogSummary": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "projectId": {"type": "string"},
          "title": {"type": "string"},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      },
      "OverviewResponse": {
        "type": "object",
        "properties": {
          "projects": {"type": "array", "items": {"$ref": "#/components/schemas/ProjectSummary"}},
          "openTasks": {"type": "array", "items": {"$ref": "#/components/schemas/TaskSummary"}},
          "inboxTasks": {"type": "array", "items": {"$ref": "#/components/schemas/TaskSummary"}},
          "recentLogs": {"type": "array", "items": {"$ref": "#/components/schemas/LogSummary"}},
          "generatedAt": {"type": "integer"}
        },
        "additionalProperties": true
      },
      "ProjectsResponse": {
        "type": "object",
        "properties": {
          "projects": {"type": "array", "items": {"$ref": "#/components/schemas/ProjectSummary"}}
        },
        "additionalProperties": true
      },
      "ProjectDetailResponse": {
        "type": "object",
        "properties": {
          "project": {"$ref": "#/components/schemas/ProjectSummary"},
          "tasks": {"type": "array", "items": {"$ref": "#/components/schemas/TaskSummary"}},
          "milestones": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true}},
          "logs": {"type": "array", "items": {"$ref": "#/components/schemas/LogSummary"}},
          "evidence": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "uri": {"type": "string"}}, "additionalProperties": true}}
        },
        "additionalProperties": true
      },
      "WorkspaceResponse": {
        "type": "object",
        "properties": {
          "project": {"$ref": "#/components/schemas/ProjectSummary"},
          "memory": {"type": "object", "properties": {"snapshot": {"type": "object", "properties": {"summary": {"type": "string"}, "currentGoal": {"type": "string"}, "nextActions": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}, "activeSession": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true}, "openBlockers": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "detail": {"type": "string"}}, "additionalProperties": true}}}, "additionalProperties": true},
          "continuation": {"type": "object", "properties": {"status": {"type": "string"}, "currentGoal": {"type": "string"}, "nextActions": {"type": "array", "items": {"type": "string"}}, "latestSummary": {"type": "string"}}, "additionalProperties": true}
        },
        "additionalProperties": true
      },
      "RepositoryContextResponse": {
        "type": "object",
        "properties": {
          "repository": {"type": "string"},
          "defaultBranch": {"type": "string"},
          "mainHeadSha": {"type": "string"},
          "openPullRequests": {"type": "array", "items": {"type": "object", "properties": {"number": {"type": "integer"}, "title": {"type": "string"}}, "additionalProperties": true}},
          "policy": {"type": "object", "properties": {"defaultBranch": {"type": "string"}}, "additionalProperties": true}
        },
        "additionalProperties": true
      },
      "RepositorySearchResponse": {
        "type": "object",
        "properties": {
          "repository": {"type": "string"},
          "query": {"type": "string"},
          "results": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string"}, "name": {"type": "string"}, "snippet": {"type": "string"}}, "additionalProperties": true}}
        },
        "additionalProperties": true
      },
      "RepositoryFileResponse": {
        "type": "object",
        "properties": {
          "repository": {"type": "string"},
          "path": {"type": "string"},
          "ref": {"type": "string"},
          "blobSha": {"type": "string"},
          "size": {"type": "integer"},
          "content": {"type": "string"},
          "htmlUrl": {"type": "string"}
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {"type": "string"},
          "details": {"type": "object", "properties": {"message": {"type": "string"}}, "additionalProperties": true}
        },
        "required": ["error"],
        "additionalProperties": true
      }
    }
  }
}