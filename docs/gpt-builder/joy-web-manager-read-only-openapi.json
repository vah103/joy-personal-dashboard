{
  "openapi": "3.1.0",
  "info": {
    "title": "Joy Web Manager Read-Only Actions",
    "version": "1.0.0",
    "description": "Read-only Actions for Joy Web Manager. Use these operations to inspect current Joy project state, workspace memory, repository context, repository search results, and current repository file contents. No write, branch, commit, pull-request, migration, or deployment operations are exposed."
  },
  "servers": [
    {
      "url": "https://app.hey-joy.workers.dev"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/joy/v1/overview": {
      "get": {
        "operationId": "getJoyOverview",
        "summary": "Get the current Joy overview",
        "description": "Read current projects, open tasks, inbox tasks, and recent logs. Use when the user's question concerns overall Joy status.",
        "responses": {
          "200": {
            "description": "Current Joy overview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/joy/v1/projects": {
      "get": {
        "operationId": "listJoyProjects",
        "summary": "List Joy projects",
        "description": "List the current Joy projects visible to this credential.",
        "responses": {
          "200": {
            "description": "Joy projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/joy/v1/projects/{projectId}": {
      "get": {
        "operationId": "getJoyProject",
        "summary": "Get one Joy project",
        "description": "Read a project and its related tasks, milestones, logs, and evidence. Use before discussing a specific project.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "Stable lowercase Joy project ID, for example ielts or turtlebot4.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/joy/v1/workspaces/{projectId}": {
      "get": {
        "operationId": "bootstrapJoyWorkspace",
        "summary": "Load one Joy project workspace",
        "description": "Load current project state, snapshot, active and recent sessions, decisions, blockers, evidence, repository references, and continuation guidance.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "Stable Joy project ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of recent records.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace bootstrap result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/joy/v1/dev/repository": {
      "get": {
        "operationId": "getJoyRepositoryContext",
        "summary": "Read current repository context",
        "description": "Call before repository or code analysis. Returns current main head, repository policy, protected paths, branch rules, limits, and open pull requests.",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "description": "Repository in owner/name form. Defaults to the Joy repository.",
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/joy/v1/dev/search": {
      "get": {
        "operationId": "searchJoyRepository",
        "summary": "Search the Joy repository",
        "description": "Search for file names, symbols, visible UI text, routes, tests, or error messages. Read relevant returned files before making conclusions.",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "description": "Repository in owner/name form. Defaults to the Joy repository.",
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/joy/v1/dev/files": {
      "get": {
        "operationId": "readJoyRepositoryFile",
        "summary": "Read one current repository file",
        "description": "Read one UTF-8 file from main or a work branch. Use after repository search and before proposing changes.",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "description": "Repository in owner/name form. Defaults to the Joy repository.",
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "Repository-relative file path.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "description": "Optional branch, tag, or commit ref. Defaults to main.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericObject"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "GenericObject": {
        "type": "object",
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      }
    },
    "responses": {
      "Error": {
        "description": "The request could not be completed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
