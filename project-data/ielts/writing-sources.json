{
  "schemaVersion": 1,
  "purpose": "Approved concrete IELTS Academic Writing prompts from STUDY4 and YouPass for Joy practice tasks.",
  "selectionPolicy": {
    "randomPracticeSkills": [
      "writing"
    ],
    "rules": [
      "Keep the official fixed source for the Writing baseline.",
      "Assign one concrete STUDY4 or YouPass prompt to each eligible Writing practice task, then keep it stable for that task.",
      "Match Task 1, Task 2 and full Writing tasks separately; prefer the requested chart or essay family when the task names one.",
      "Do not repeat a prompt attached to a completed task until every eligible prompt in that pool has been used.",
      "Use only the prompt or chart before the first draft; do not read provider guidance or a model answer until the original response is complete.",
      "Keep the original response, actual time, four-criterion feedback and targeted rewrite as evidence.",
      "A pending task may be assigned another prompt; an in-progress or completed task keeps its assignment."
    ],
    "storeOnly": [
      "providerId",
      "providerName",
      "testId",
      "testTitle",
      "testUrl",
      "scope",
      "taskPart",
      "writingType",
      "sectionLabel",
      "promptCount",
      "assignedAt",
      "actualMinutes",
      "originalResponse",
      "criterionFeedback",
      "rewrite",
      "learnerReflection"
    ],
    "neverStore": [
      "copiedProviderGuidance",
      "copiedModelAnswer",
      "fullThirdPartyPromptBank"
    ]
  },
