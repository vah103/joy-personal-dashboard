{
  "schemaVersion": 1,
  "purpose": "Approved IELTS Speaking question sets from STUDY4 and YouPass for Joy chat-first practice.",
  "selectionPolicy": {
    "randomPracticeSkills": [
      "speaking"
    ],
    "rules": [
      "Keep the official fixed source for the Speaking baseline.",
      "Assign one concrete STUDY4 or YouPass set to each eligible Speaking practice task, then keep it stable for that task.",
      "Match Part 1, Part 2, Part 3, Part 2+3 and full mock tasks separately where possible.",
      "Do not repeat a set attached to a completed task until every eligible set in that pool has been used.",
      "Use chat-first interaction: ask one question at a time and wait for the learner's immediate typed answer.",
      "Do not show provider samples, hints or model answers before the learner submits the original answer.",
      "Assess content development, coherence, vocabulary and grammar from text; mark fluency evidence as limited and pronunciation as not assessed.",
      "A pending task may be assigned another set; an in-progress or completed task keeps its assignment."
    ],
    "storeOnly": [
      "providerId",
      "providerName",
      "testId",
      "testTitle",
      "testUrl",
      "scope",
      "taskPart",
      "speakingParts",
      "topicTags",
      "sectionLabel",
      "interactionMode",
      "assignedAt",
      "originalAnswers",
      "responseTiming",
      "textFeedback",
      "repeatedAnswers",
      "learnerReflection"
    ],
    "neverStore": [
      "copiedProviderSamples",
      "copiedModelAnswers",
      "fullThirdPartyQuestionBank",
      "pronunciationScoreFromText",
      "officialBandClaimFromText"
    ]
  },
