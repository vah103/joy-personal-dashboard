{
  "schemaVersion": 2,
  "purpose": "Approved concrete source catalog for assigning IELTS Listening and Reading practice without inventing tests or answer keys.",
  "selectionPolicy": {
    "randomCheckedPracticeSkills": [
      "listening",
      "reading"
    ],
    "rules": [
      "Listening and Reading tasks use only concrete tests from STUDY4 or YouPass in this catalog.",
      "Assign one random eligible test the first time a task is opened or started, then keep that assignment for the task.",
      "Do not repeat a test that is attached to a completed task until every eligible test for that skill and scope has been used.",
      "Baseline and other full-test tasks require a verified 40-question full test; focused practice may use a full test or one checked section.",
      "The owner completes the work on the provider platform; Joy does not scrape or reproduce the full test.",
      "Treat provider results and answer explanations as diagnostic practice evidence, not as an official IELTS score.",
      "A pending task may be assigned another test; an in-progress or completed task keeps its assignment."
    ],
    "storeOnly": [
      "providerId",
      "providerName",
      "testId",
      "testTitle",
      "testUrl",
      "scope",
      "questionCount",
      "assignedAt",
      "rawResult",
      "wrongItems",
      "platformChecked",
      "learnerReflection"
    ],
    "neverStore": [
      "fullTestContent",
      "copiedPassages",
      "copiedAudio",
      "fullThirdPartyAnswerKey"
    ]
  },
