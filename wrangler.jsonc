{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker/router.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DAILY_BRIEF_AI_ENABLED": "true",
    "OPENAI_VOCABULARY_MODEL": "gpt-5-mini",
    "OPENAI_SPEAKING_MODEL": "gpt-4o-mini"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/",
      "/index.html",
      "/sale-manager.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joy-dashboard",
      "database_id": "cf56b5be-2d98-4ae6-9fc1-357a21d821ff",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
