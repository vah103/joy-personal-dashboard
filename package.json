{
  "name": "joy-personal-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-ielts-sources.mjs && node scripts/build.mjs && node scripts/build-finance-bundle.mjs",
    "test": "node scripts/run-tests.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=critical",
    "test:finance": "node scripts/run-feature-tests.mjs finance",
    "test:ielts": "node scripts/run-feature-tests.mjs ielts",
    "dev": "npm run build && wrangler dev",
    "deploy": "node scripts/deploy-clean-main.mjs",
    "deploy:current": "npm test && npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply joy-dashboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply joy-dashboard --remote"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/quicksand": "^5.2.8",
    "wrangler": "^4.115.0"
  }
}
